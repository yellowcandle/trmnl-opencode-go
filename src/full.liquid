<div class="layout layout--col gap--space-between">
  {% if go and go.available %}
      {% comment %} Weekly hero {% endcomment %}
      <div class="flex flex--row flex--between w--full">
        <div class="flex flex--col">
          <span class="label">WEEKLY WINDOW</span>
          <div class="flex flex--row flex--center-y gap--small">
            <span class="value value--large value--tnums">{{ go.weekly.percent | default: 0 | round: 0 }}</span>
            <div class="flex flex--col">
              <span class="value value--small">%</span>
              <span class="label">USED</span>
            </div>
          </div>
        </div>
        <div class="flex flex--col gap--small">
          <div class="flex flex--col">
            <span class="label label--small">REMAINING</span>
            <span class="value value--small value--tnums">{{ go.weekly.remaining_percent | default: 0 | round: 1 }}%</span>
          </div>
          <div class="flex flex--col">
            <span class="label label--small">RESETS IN</span>
            <span class="value value--small value--tnums">{{ go.weekly.resets_in | default: "—" }}</span>
          </div>
        </div>
      </div>

      {% comment %} Weekly window bar {% endcomment %}
      <div class="progress-bar w--full">
        <div class="track">
          <div class="fill" style="width: {{ go.weekly.percent | default: 0 }}%"></div>
        </div>
      </div>
      <div class="flex flex--row flex--between w--full">
        <span class="label label--small">0</span>
        <span class="label label--small label--underline">weekly {{ go.weekly.percent | default: 0 | round: 0 }}% · {{ go.weekly.percent | default: 0 | times: 0.44 | round: 0 }} of 44 units</span>
        <span class="label label--small">100</span>
      </div>

      <div class="border border--h border--h-10"></div>

      {% comment %} Secondary windows {% endcomment %}
      <div class="flex flex--row gap--regular w--full">
        <div class="flex flex--col flex--1 gap--small">
          <div class="flex flex--row flex--between flex--center-y">
            <span class="label label--small">5-HOUR</span>
            <span class="value value--small value--tnums">{{ go.rolling.percent | default: 0 | round: 0 }}%</span>
          </div>
          <div class="progress-bar progress-bar--xsmall w--full">
            <div class="track"><div class="fill" style="width: {{ go.rolling.percent | default: 0 }}%"></div></div>
          </div>
          <div class="flex flex--row flex--between">
            <span class="label label--small">{{ go.rolling.remaining_percent | default: 0 | round: 0 }}% left</span>
            <span class="label label--small">resets {{ go.rolling.resets_in | default: "—" }}</span>
          </div>
        </div>
        <div class="border border--v border--h-10"></div>
        <div class="flex flex--col flex--1 gap--small">
          <div class="flex flex--row flex--between flex--center-y">
            <span class="label label--small">MONTHLY</span>
            <span class="value value--small value--tnums">{{ go.monthly.percent | default: 0 | round: 0 }}%</span>
          </div>
          <div class="progress-bar progress-bar--xsmall w--full">
            <div class="track"><div class="fill" style="width: {{ go.monthly.percent | default: 0 }}%"></div></div>
          </div>
          <div class="flex flex--row flex--between">
            <span class="label label--small">{{ go.monthly.remaining_percent | default: 0 | round: 0 }}% left</span>
            <span class="label label--small">resets {{ go.monthly.resets_in | default: "—" }}</span>
          </div>
        </div>
      </div>

      {% comment %} Forecast note {% endcomment %}
      <div class="item item--inverse bg--black">
        <div class="content w--full">
          <div class="flex flex--row flex--between flex--center-y w--full">
            <div class="flex flex--col gap--xsmall">
              <span class="label label--small text--white">FORECAST</span>
              <span class="description text--white">Weekly is binding · tightest window governs headroom</span>
            </div>
            <span class="label label--small text--white">{{ go.max_percent | default: 0 | round: 0 }}% peak</span>
          </div>
        </div>
      </div>

      {% if error %}
        <div class="item item--emphasis-2">
          <div class="content">
            <span class="label label--small label--underline">Sync note</span>
            <span class="description" data-clamp="2">{{ error }}</span>
          </div>
        </div>
      {% endif %}
    {% else %}
      <div class="flex flex--col flex--center-y flex--center-x h--full gap--small">
        <span class="title">OpenCode Go</span>
        <span class="description" data-clamp="4">{{ error | default: "Quota unavailable. Sign in to OpenCode Console and run scripts/sync.py." }}</span>
      </div>
    {% endif %}
  </div>
  <div class="title_bar">
    <span class="title">OPENCODE GO</span>
    <span class="instance">{{ workspace.name | default: "Quota" }}{% if updated_at %} · {{ updated_at }}{% endif %}</span>
  </div>
</div>
